{
  "standard_name": "ArCode-Standard",
  "version": "1.2",
  "status": "Foundation Stage",

  "core_principles": [
    "كل مصطلح يجب أن يكون ثنائي اللغة (AR + EN)",
    "كل مصطلح يجب أن ينتمي إلى Domain واحد فقط",
    "كل مصطلح يجب أن يحمل تعريف واضح وغير غامض",
    "كل ID يجب أن يكون فريد وغير قابل للتكرار",
    "المعيار يجب أن يبقى مستقلاً عن أي لغة برمجة",
    "كل مصطلح يجب أن يستند إلى مصدر موثوق (SOURCE)"
  ],

  "term_required_fields": [
    "ACS_ID",
    "AR_TERM",
    "EN_TERM",
    "DOMAIN",
    "DEFINITION_AR",
    "DEFINITION_EN",
    "STATUS",
    "SOURCE"
  ],

  "term_optional_fields": [
    "RELATIONS",
    "VERSION",
    "NOTES"
  ],

  "allowed_status_values": [
    "Draft",
    "Approved",
    "Deprecated"
  ],

  "domain_codes": {
    "GEN":  "General Knowledge",
    "CS":   "Computer Science",
    "AI":   "Artificial Intelligence",
    "NET":  "Networking",
    "SEC":  "Cybersecurity",
    "MATH": "Mathematics",
    "PHYS": "Physics",
    "BIO":  "Biology",
    "CHEM": "Chemistry",
    "ENG":  "Engineering",
    "MED":  "Medicine",
    "LING": "Linguistics",
    "ECON": "Economics"
  }
}
